+    fun exportKlines(context: android.content.Context, symbol: String, interval: String, format: String) {
+        viewModelScope.launch {
+            try {
+                val effectiveSymbol = if (symbol == "ALL") "MNTUSDT" else symbol
+                
+                // Request 1000 candles as requested
+                val result = repository.getKlines(symbol = effectiveSymbol, interval = interval, limit = 1000)
+                
+                result.onSuccess { klineResult ->
+                    if (klineResult.list.isEmpty()) {
+                        android.widget.Toast.makeText(context, "Hiç kline verisi bulunamadı", android.widget.Toast.LENGTH_SHORT).show()
+                    } else {
+                        KlineExporter.shareKlinesAsFile(context, klineResult, effectiveSymbol, interval, format)
+                    }
+                }.onFailure { e ->
+                    android.widget.Toast.makeText(context, "Kline verisi alınamadı: ${e.message}", android.widget.Toast.LENGTH_LONG).show()
+                }
+            } catch (e: Exception) {
+                android.widget.Toast.makeText(context, "Kline verisi alınırken hata oluştu", android.widget.Toast.LENGTH_SHORT).show()
+            }
+        }
+    }
